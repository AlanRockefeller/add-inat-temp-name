{
  "manifest_version": 3,
  "name": "iNat Add Temp Name",
  "version": "0.2",
  "description": "Create provisional (temp) fungal names on iNaturalist from observations, one at a time or in batches.",
  "action": {
    "default_title": "Batch add temp names",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://www.inaturalist.org/*",
    "https://api.inaturalist.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.inaturalist.org/observations/*"
      ],
      "js": [
        "common.js",
        "observation.js"
      ],
      "css": [
        "observation.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.inaturalist.org/taxa/new*"
      ],
      "js": [
        "common.js",
        "taxon_new.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.inaturalist.org/taxa*"
      ],
      "exclude_matches": [
        "https://www.inaturalist.org/taxa/new*"
      ],
      "js": [
        "common.js",
        "taxon_result.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "inat-add-temp-name@alanrockefeller",
      "strict_min_version": "109.0"
    }
  }
}
